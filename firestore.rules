rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'afa469382@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Validation Blueprints
    function isValidGameState(data) {
      return data.keys().hasOnly([
        'roundId',
        'roundIndex',
        'roundTime',
        'roundDuration',
        'roundEndTime',
        'countdown',
        'isRevealing',
        'revealStep',
        'revealStartTime',
        'forcedWinningNumber',
        'drawMix',
        'pendingWinningResult',
        'payoutOdds',
        'autoDrawEnabled',
        'updatedAt'
      ]) &&
      (!('roundId' in data) || (data.roundId is string && data.roundId.size() <= 64)) &&
      (!('roundIndex' in data) || (data.roundIndex is number && data.roundIndex >= 1)) &&
      (!('roundTime' in data) || (data.roundTime is string && data.roundTime.size() <= 32)) &&
      (!('roundDuration' in data) || (data.roundDuration is number && data.roundDuration >= 15 && data.roundDuration <= 3600)) &&
      (!('roundEndTime' in data) || (data.roundEndTime is number && data.roundEndTime >= 0)) &&
      (!('countdown' in data) || (data.countdown is number && data.countdown >= 0 && data.countdown <= 3600)) &&
      (!('isRevealing' in data) || (data.isRevealing is bool)) &&
      (!('revealStep' in data) || (data.revealStep is number && data.revealStep >= 0 && data.revealStep <= 12)) &&
      (!('revealStartTime' in data) || (data.revealStartTime is number && data.revealStartTime >= 0)) &&
      (!('forcedWinningNumber' in data) || data.forcedWinningNumber == null || (data.forcedWinningNumber is number && data.forcedWinningNumber >= 1 && data.forcedWinningNumber <= 12)) &&
      (!('drawMix' in data) || (data.drawMix is list && data.drawMix.size() <= 12)) &&
      (!('pendingWinningResult' in data) || data.pendingWinningResult == null || (data.pendingWinningResult is map)) &&
      (!('payoutOdds' in data) || (data.payoutOdds is map)) &&
      (!('autoDrawEnabled' in data) || (data.autoDrawEnabled is bool)) &&
      (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidDrawResult(data) {
      return data.keys().hasAll(['roundId', 'roundIndex', 'number', 'animal', 'color', 'size', 'parity']) &&
        data.keys().hasOnly([
          'roundId',
          'roundIndex',
          'date',
          'year',
          'month',
          'day',
          'time',
          'number',
          'animal',
          'color',
          'size',
          'parity',
          'timestamp',
          'savedAt'
        ]) &&
        data.roundId is string && data.roundId.size() >= 1 && data.roundId.size() <= 64 &&
        data.roundIndex is number && data.roundIndex >= 1 &&
        data.number is number && data.number >= 1 && data.number <= 12 &&
        data.animal is string && data.animal.size() >= 1 && data.animal.size() <= 32 &&
        data.color is string && data.color in ['red', 'green', 'blue'] &&
        data.size is string && data.size in ['small', 'big'] &&
        data.parity is string && data.parity in ['odd', 'even'] &&
        (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
        (!('year' in data) || (data.year is number && data.year >= 2000 && data.year <= 2100)) &&
        (!('month' in data) || (data.month is number && data.month >= 1 && data.month <= 12)) &&
        (!('day' in data) || (data.day is number && data.day >= 1 && data.day <= 31)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 32)) &&
        (!('timestamp' in data) || (data.timestamp is number)) &&
        (!('savedAt' in data) || (data.savedAt is string && data.savedAt.size() <= 64));
    }

    function isValidBetRecord(data) {
      return data.keys().hasAll(['id', 'roundId', 'totalStake', 'status']) &&
        data.keys().hasOnly([
          'id',
          'ticketId',
          'userId',
          'roundId',
          'date',
          'year',
          'month',
          'day',
          'time',
          'timestamp',
          'isRealBet',
          'bets',
          'totalStake',
          'totalPotentialPayout',
          'totalPayout',
          'netProfit',
          'resultNumber',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.roundId is string && data.roundId.size() >= 1 && data.roundId.size() <= 64 &&
        data.totalStake is number && data.totalStake > 0 &&
        data.status is string && data.status in ['pending', 'won', 'lost'] &&
        (!('ticketId' in data) || (data.ticketId is string && data.ticketId.size() <= 32)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
        (!('year' in data) || (data.year is number && data.year >= 2000 && data.year <= 2100)) &&
        (!('month' in data) || (data.month is number && data.month >= 1 && data.month <= 12)) &&
        (!('day' in data) || (data.day is number && data.day >= 1 && data.day <= 31)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 32)) &&
        (!('timestamp' in data) || (data.timestamp is number)) &&
        (!('isRealBet' in data) || (data.isRealBet is bool)) &&
        (!('bets' in data) || (data.bets is list && data.bets.size() <= 50)) &&
        (!('totalPotentialPayout' in data) || (data.totalPotentialPayout is number)) &&
        (!('totalPayout' in data) || (data.totalPayout is number)) &&
        (!('netProfit' in data) || (data.netProfit is number)) &&
        (!('resultNumber' in data) || (data.resultNumber is number && data.resultNumber >= 1 && data.resultNumber <= 12)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userName', 'type', 'amount', 'method', 'status']) &&
        data.keys().hasOnly([
          'id',
          'userName',
          'userPhone',
          'type',
          'amount',
          'method',
          'status',
          'timestamp',
          'timeString',
          'note',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 128 &&
        data.type is string && data.type in ['deposit', 'withdrawal', 'adjustment'] &&
        data.amount is number && data.amount > 0 &&
        data.method is string && data.method.size() <= 64 &&
        data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
        (!('userPhone' in data) || (data.userPhone is string && data.userPhone.size() <= 64)) &&
        (!('timestamp' in data) || (data.timestamp is number)) &&
        (!('timeString' in data) || (data.timeString is string && data.timeString.size() <= 32)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 256)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'balance', 'role']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'balance', 'role', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        data.balance is number && data.balance >= 0 &&
        data.role is string && data.role in ['admin', 'player'] &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Connection verification test path
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Authoritative Game State
    match /game_state/{stateId} {
      allow get, list: if true;
      allow create, update: if isValidId(stateId) && isValidGameState(incoming());
    }

    // Draw History
    match /draw_history/{roundId} {
      allow get, list: if true;
      allow create, update: if isValidId(roundId) && isValidDrawResult(incoming());
      allow delete: if isValidId(roundId);
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isValidId(userId) && isValidUser(incoming()) && (isOwner(userId) || isAdmin());
    }

    // Bets Collection
    match /bets/{betId} {
      allow get, list: if true;
      allow create, update: if isValidId(betId) && isValidBetRecord(incoming());
      allow delete: if isValidId(betId);
    }

    // Transactions Collection
    match /transactions/{txId} {
      allow get, list: if true;
      allow create, update: if isValidId(txId) && isValidTransaction(incoming());
    }
  }
}
